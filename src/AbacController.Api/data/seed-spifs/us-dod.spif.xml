  <!-- ORDER MATTERS: CAPCO requires SCI → SAP → Dissemination Controls → Releasable Nations -->
  <securityCategoryTagSets>
    <!-- SCI Compartments — LACV gated at SECRET (4) -->
    <securityCategoryTagSet tagSetName="SCI Compartments"
                            tagSetId="2.16.840.1.101.2.1.1.1.2"
                            displayName="SCI Compartments"
                            displayOrder="1"
                            applicableClassificationMinLacv="4">
      <securityCategoryTag tagName="HCS" lacv="1" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="HCS" isPortionMarking="true" portionAbbreviation="HCS" />
          <markingCode codeValue="HCS" />
        </markingData>
      </securityCategoryTag>

      <securityCategoryTag tagName="SI" lacv="2" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="SI" isPortionMarking="true" portionAbbreviation="SI" />
          <markingCode codeValue="SI" />
        </markingData>
      </securityCategoryTag>

      <securityCategoryTag tagName="TK" lacv="3" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="TK" isPortionMarking="true" portionAbbreviation="TK" />
          <markingCode codeValue="TK" />
        </markingData>
      </securityCategoryTag>

      <securityCategoryTag tagName="G" lacv="4" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="GAMMA" isPortionMarking="true" portionAbbreviation="G" />
          <markingCode codeValue="G" />
        </markingData>
      </securityCategoryTag>
    </securityCategoryTagSet>

    <!-- SAP Programs — LACV gated at SECRET (4) -->
    <securityCategoryTagSet tagSetName="SAP Programs"
                            tagSetId="2.16.840.1.101.2.1.1.1.3"
                            displayName="Special Access Programs"
                            displayOrder="2"
                            applicableClassificationMinLacv="4">
      <securityCategoryTag tagName="SAR-ALPHA" lacv="1" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="SAR-ALPHA" isPortionMarking="true" portionAbbreviation="SAR-ALPHA" />
          <markingCode codeValue="SAR-ALPHA" />
        </markingData>
      </securityCategoryTag>

      <securityCategoryTag tagName="SAR-BRAVO" lacv="2" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="SAR-BRAVO" isPortionMarking="true" portionAbbreviation="SAR-BRAVO" />
          <markingCode codeValue="SAR-BRAVO" />
        </markingData>
      </securityCategoryTag>
    </securityCategoryTagSet>

    <!-- Dissemination Controls — per CAPCO Implementation Manual (CONFIDENTIAL and above) -->
    <securityCategoryTagSet tagSetName="Dissemination Controls"
                            tagSetId="2.16.840.1.101.2.1.1.1.1"
                            displayName="Dissemination Controls"
                            displayOrder="3"
                            applicableClassificationMinLacv="3">
      <securityCategoryTag tagName="NOFORN" lacv="1" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="NOFORN" isPortionMarking="true" portionAbbreviation="NF" />
          <markingCode codeValue="NF" />
        </markingData>
      </securityCategoryTag>

      <securityCategoryTag tagName="REL TO" lacv="2" tagType="permissive">
        <markingData>
          <markingPhrase phraseText="REL TO" isPortionMarking="true" portionAbbreviation="REL" />
          <markingCode codeValue="REL" />
        </markingData>
      </securityCategoryTag>

      <securityCategoryTag tagName="ORCON" lacv="3" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="ORIGINATOR CONTROLLED" isPortionMarking="true" portionAbbreviation="OC" />
          <markingCode codeValue="OC" />
        </markingData>
      </securityCategoryTag>

      <securityCategoryTag tagName="PROPIN" lacv="4" tagType="restrictive">
        <markingData>
          <markingPhrase phraseText="CAUTION - PROPRIETARY INFORMATION INVOLVED" isPortionMarking="true" portionAbbreviation="PR" />
          <markingCode codeValue="PR" />
        </markingData>
      </securityCategoryTag>

      <!-- NOFORN and REL TO are mutually exclusive per CAPCO -->
      <categoryConstraint constraintType="mutualExclusion"
                          sourceTagSetId="2.16.840.1.101.2.1.1.1.1" sourceTagLacv="1"
                          targetTagSetId="2.16.840.1.101.2.1.1.1.1" targetTagLacv="2"
                          severity="error">
        <errorMessage>NOFORN and REL TO cannot be selected together — NOFORN prohibits foreign release.</errorMessage>
      </categoryConstraint>
    </securityCategoryTagSet>

    <!-- Releasable Nations — for REL TO nation selection (CONFIDENTIAL and above) -->
    <securityCategoryTagSet tagSetName="Releasable Nations"
