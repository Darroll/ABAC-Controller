  <!-- Authority field definitions for the classified email compose form -->
  <extensions>
    <freeFormField fieldName="authority.showForClassified" fieldValue="true" />
    <freeFormField fieldName="authority.classifiedBy" fieldValue="Classified by|text|true||CLASSIFIED BY" />
    <freeFormField fieldName="authority.agency" fieldValue="Agency|text|true||AGENCY" />
    <freeFormField fieldName="authority.reason" fieldValue="Reason|text|true||REASON" />
    <freeFormField fieldName="authority.derivedFrom" fieldValue="Derived from|text|true|Multiple Sources|DERIVED FROM" />
