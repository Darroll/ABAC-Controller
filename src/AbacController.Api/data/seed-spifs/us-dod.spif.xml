      <securityCategoryTag tagName="AUS" lacv="5" tagType="permissive">
        <markingData>
          <markingPhrase phraseText="AUS" isPortionMarking="true" portionAbbreviation="AUS" />
          <markingCode codeValue="AUS" />
        </markingData>
