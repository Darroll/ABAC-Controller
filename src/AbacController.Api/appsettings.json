{
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=abac-controller.db"
  },
  "Auth": {
    "Authority": "",
    "Audience": "abac-controller",
    "RequireHttpsMetadata": true,
    "EnableDevelopmentAuth": false
  },
  "Pdp": {
    "DecisionCacheTtlSeconds": 300,
    "DecisionCacheEnabled": true
  },
  "RateLimiting": {
    "PdpPermitLimit": 1000,
    "WindowSeconds": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
