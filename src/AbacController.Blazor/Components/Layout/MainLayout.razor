@inherits LayoutComponentBase

<div class="admin-portal">
    <header class="admin-topbar">
        <div class="admin-topbar-brand">🛡️ ABAC Controller — Policy Administration</div>
        <div class="admin-topbar-info">PAP v1.0</div>
    </header>
    <div class="admin-layout">
        <nav class="admin-sidebar" role="navigation" aria-label="Admin navigation">
            <ul>
                <li><NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink></li>

                <li class="nav-section">SPIF Policies</li>
                <li><NavLink href="/spif" Match="NavLinkMatch.All">SPIF Management</NavLink></li>
                <li><NavLink href="/spif/create" Match="NavLinkMatch.All">Create New SPIF</NavLink></li>

                <li class="nav-section">Access Policies</li>
                <li><NavLink href="/policies" Match="NavLinkMatch.All">Policy Sets</NavLink></li>

                <li class="nav-section">Attributes</li>
                <li><NavLink href="/pip" Match="NavLinkMatch.All">PIP Sources</NavLink></li>

                <li class="nav-section">System</li>
                <li><NavLink href="/audit" Match="NavLinkMatch.All">Audit Log</NavLink></li>
                <li><NavLink href="/system" Match="NavLinkMatch.All">System Status</NavLink></li>
            </ul>
        </nav>
        <main class="admin-content" role="main">
            @Body
        </main>
    </div>
</div>

<style>
    /* ── Admin Portal Shell ── */
    .admin-portal {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    /* ── Top Bar ── */
    .admin-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 48px;
        padding: 0 1.25rem;
        background: #1a1a2e;
        color: #ffffff;
        flex-shrink: 0;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .admin-topbar-brand {
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: 0.02em;
    }

    .admin-topbar-info {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.7);
    }

    /* ── Sidebar + Content Row ── */
    .admin-layout {
        display: flex;
        flex: 1;
        overflow: hidden;
    }

    /* ── Sidebar ── */
    .admin-sidebar {
        width: 220px;
        min-width: 220px;
        background: #f5f6fa;
        border-right: 1px solid #e0e0e0;
        overflow-y: auto;
        padding: 0.5rem 0;
        flex-shrink: 0;
    }

    .admin-sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .admin-sidebar a {
        display: block;
        padding: 0.5rem 1rem;
        color: #333;
        text-decoration: none;
        font-size: 0.9rem;
        border-left: 3px solid transparent;
        transition: background-color 0.15s, border-color 0.15s;
    }

    .admin-sidebar a:hover {
        background: #e8eaf6;
        border-left-color: #5c6bc0;
        color: #1a1a2e;
    }

    .admin-sidebar a.active {
        background: #e8eaf6;
        border-left-color: #3f51b5;
        font-weight: 600;
        color: #1a1a2e;
    }

    .nav-section {
        font-weight: 700;
        font-size: 0.72em;
        text-transform: uppercase;
        color: #6c757d;
        padding: 0.75rem 1rem 0.25rem;
        margin-top: 0.25rem;
        list-style: none;
        letter-spacing: 0.05em;
    }

    /* ── Content Area ── */
    .admin-content {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem 2rem;
        background: #ffffff;
    }
</style>
