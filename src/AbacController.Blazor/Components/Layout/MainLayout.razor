@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <h4>ABAC Controller — Policy Administration</h4>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        display: flex;
        min-height: 100vh;
    }
    .sidebar {
        width: 250px;
        background: #1e1e2f;
        color: white;
        padding: 1rem;
    }
    .sidebar a {
        color: #ccc;
        display: block;
        padding: 0.5rem 0;
        text-decoration: none;
    }
    .sidebar a:hover, .sidebar a.active {
        color: white;
    }
    main {
        flex: 1;
    }
    .top-row {
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 0.75rem 1rem;
    }
    .content {
        padding: 1rem;
    }
</style>
