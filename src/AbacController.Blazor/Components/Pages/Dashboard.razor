@page "/"
@inject HttpClient Http
@implements IDisposable

<h2>ABAC Controller — Dashboard</h2>
<p class="text-muted" style="margin-top:-0.5rem; margin-bottom:1.5rem; font-size:0.95rem;">
    Overview of the Policy Administration Point. Metrics refresh every 10 seconds.
</p>

<div class="dashboard-metrics mb-4">
    <div class="metric-card">
        <h4>SPIFs Loaded</h4>
        <p class="metric-value">@_spifCount</p>
    </div>
    <div class="metric-card">
        <h4>Active SPIFs</h4>
        <p class="metric-value">@_activeSpifCount</p>
    </div>
    <div class="metric-card">
        <h4>Policy Sets</h4>
        <p class="metric-value">@_policySetCount</p>
    </div>
    <div class="metric-card">
        <h4>PIP Sources</h4>
        <p class="metric-value">@_pipSourceCount</p>
    </div>
    <div class="metric-card">
        <h4>Enforcement Points</h4>
        <p class="metric-value">@_pepCount</p>
    </div>
</div>

@* Live metrics from Prometheus *@
@if (_metricsLoaded)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Live Decision Metrics</strong>
            <small class="text-muted">Updated @_metricsUpdatedAt?.ToString("HH:mm:ss")</small>
        </div>
        <div class="card-body">
            <div class="dashboard-metrics">
                <div class="metric-card metric-highlight">
                    <h4>Total Evaluations</h4>
                    <p class="metric-value">@_totalEvaluations</p>
                </div>
                <div class="metric-card" style="background:#e8f5e9;">
                    <h4>Permit</h4>
                    <p class="metric-value" style="color:#2e7d32;">@_permitCount</p>
                </div>
                <div class="metric-card" style="background:#ffebee;">
                    <h4>Deny</h4>
                    <p class="metric-value" style="color:#c62828;">@_denyCount</p>
                </div>
                <div class="metric-card" style="background:#fff3e0;">
                    <h4>Not Applicable</h4>
                    <p class="metric-value" style="color:#e65100;">@_notApplicableCount</p>
                </div>
                <div class="metric-card" style="background:#fce4ec;">
                    <h4>Indeterminate</h4>
                    <p class="metric-value" style="color:#880e4f;">@_indeterminateCount</p>
                </div>
                <div class="metric-card">
                    <h4>Batch Members</h4>
                    <p class="metric-value">@_batchCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Cache Performance</strong></div>
                <div class="card-body">
                    <div class="dashboard-metrics">
                        <div class="metric-card" style="background:#e3f2fd;">
                            <h4>Cache Hits</h4>
                            <p class="metric-value" style="color:#1565c0;">@_cacheHits</p>
                        </div>
                        <div class="metric-card" style="background:#f3e5f5;">
                            <h4>Cache Misses</h4>
                            <p class="metric-value" style="color:#6a1b9a;">@_cacheMisses</p>
                        </div>
                        <div class="metric-card">
                            <h4>Hit Rate</h4>
                            <p class="metric-value" style="font-size:1.5rem;">@_cacheHitRate</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>PIP &amp; Performance</strong></div>
                <div class="card-body">
                    <div class="dashboard-metrics">
                        <div class="metric-card">
                            <h4>PIP Resolutions</h4>
                            <p class="metric-value">@_pipResolutions</p>
                        </div>
                        <div class="metric-card" style="background:#ffebee;">
                            <h4>PIP Failures</h4>
                            <p class="metric-value" style="color:#c62828;">@_pipFailures</p>
                        </div>
                        <div class="metric-card">
                            <h4>Avg Eval (ms)</h4>
                            <p class="metric-value" style="font-size:1.5rem;">@_avgEvalMs</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_pipHealthLoaded)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>PIP Source Health</strong>
            @if (_pipAllHealthy)
            {
                <span class="badge bg-success">All Healthy</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Degraded</span>
            }
        </div>
        <div class="card-body p-0">
            @if (_pipHealthSources.Count == 0)
            {
                <div class="p-3 text-muted"><em>No PIP sources registered.</em></div>
            }
            else
            {
                <table class="admin-table mb-0">
                    <thead>
                        <tr><th>Source</th><th>Status</th><th>Last Check</th><th>Message</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var src in _pipHealthSources)
                        {
                            <tr>
                                <td><strong>@src.SourceId</strong></td>
                                <td>
                                    <span class="badge @(src.Healthy ? "bg-success" : "bg-danger")">
                                        @(src.Healthy ? "Healthy" : "Unhealthy")
                                    </span>
                                </td>
                                <td><small>@src.LastChecked?.ToString("HH:mm:ss")</small></td>
                                <td><small class="text-muted">@(src.Message ?? "—")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (_statusReady.HasValue)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>System Status</strong>
            @if (_statusReady.Value)
            {
                <span class="badge bg-success">Ready</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Starting Up</span>
            }
        </div>
        <div class="card-body">
            <table class="info-table">
                <tr>
                    <td><strong>Runtime</strong></td>
                    <td>@_runtime</td>
                </tr>
                @if (_registeredCodecs is { Count: > 0 })
                {
                    <tr>
                        <td><strong>Label Codecs</strong></td>
                        <td>
                            @foreach (var codec in _registeredCodecs)
                            {
                                <span class="badge bg-secondary me-1">@codec</span>
                            }
                        </td>
                    </tr>
                }
                @if (_registeredOids is { Count: > 0 })
                {
                    <tr>
                        <td><strong>Registered SPIFs</strong></td>
                        <td>
                            @foreach (var oid in _registeredOids)
                            {
                                <code class="me-2" style="font-size:0.8rem;">@oid</code>
                            }
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
}

<div class="quick-links">
    <h5>Quick Actions</h5>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/spif/create" class="btn btn-outline-primary">
            <span class="oi oi-plus me-1"></span> Create SPIF
        </a>
        <a href="/spif" class="btn btn-outline-secondary">
            <span class="oi oi-document me-1"></span> Manage SPIFs
        </a>
        <a href="/test" class="btn btn-outline-info">
            <span class="oi oi-beaker me-1"></span> Decision Tester
        </a>
        <a href="/pip" class="btn btn-outline-secondary">
            <span class="oi oi-pulse me-1"></span> PIP Sources
        </a>
        <a href="/audit" class="btn btn-outline-secondary">
            <span class="oi oi-list me-1"></span> Audit Log
        </a>
        <a href="/system" class="btn btn-outline-secondary">
            <span class="oi oi-cog me-1"></span> System
        </a>
    </div>
</div>

<style>
    .dashboard-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 1rem;
    }

    .metric-card {
        background: #f5f6fa;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        text-align: center;
    }

    .metric-card h4 {
        margin: 0 0 0.5rem;
        font-size: 0.78rem;
        color: #6c757d;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .metric-card .metric-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a2e;
    }

    .metric-highlight {
        background: #e8eaf6 !important;
        border-color: #3f51b5 !important;
    }

    .info-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .info-table td {
        padding: 0.4rem 0.5rem;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: top;
    }

    .info-table td:first-child {
        width: 160px;
        color: #6c757d;
    }

    .quick-links h5 {
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
        color: #495057;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

    .admin-table thead th {
        text-align: left;
        padding: 0.5rem 0.75rem;
        background: #f5f6fa;
        border-bottom: 1px solid #dee2e6;
        font-weight: 600;
        color: #6c757d;
        font-size: 0.8rem;
    }

    .admin-table tbody td {
        padding: 0.4rem 0.75rem;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
    }
</style>

@code {
    private int _spifCount;
    private int _activeSpifCount;
    private int _policySetCount;
    private int _pipSourceCount;
    private int _pepCount;
    private bool? _statusReady;
    private string? _runtime;
    private List<string>? _registeredCodecs;
    private List<string>? _registeredOids;

    // Live metrics
    private bool _metricsLoaded;
    private DateTime? _metricsUpdatedAt;
    private long _totalEvaluations;
    private long _permitCount;
    private long _denyCount;
    private long _notApplicableCount;
    private long _indeterminateCount;
    private long _batchCount;
    private long _cacheHits;
    private long _cacheMisses;
    private string _cacheHitRate = "—";
    private long _pipResolutions;
    private long _pipFailures;
    private string _avgEvalMs = "—";

    // PIP health
    private bool _pipHealthLoaded;
    private bool _pipAllHealthy;
    private List<PipHealthRow> _pipHealthSources = [];

    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await LoadMetricsAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadAllAsync()
    {
        try
        {
            var spifsTask = Http.GetFromJsonAsync<List<SpifRow>>("pap/api/spifs");
            var policySetsTask = Http.GetFromJsonAsync<List<object>>("pap/api/policy-sets");
            var pipSourcesTask = Http.GetFromJsonAsync<List<object>>("pip/api/sources");
            var statusTask = Http.GetFromJsonAsync<StatusRow>("system/api/info");
            var pepTask = Http.GetFromJsonAsync<List<object>>("system/api/enforcement-points");

            await Task.WhenAll(
                spifsTask.ContinueWith(_ => { }),
                policySetsTask.ContinueWith(_ => { }),
                pipSourcesTask.ContinueWith(_ => { }),
                statusTask.ContinueWith(_ => { }),
                pepTask.ContinueWith(_ => { }));

            if (spifsTask.IsCompletedSuccessfully && spifsTask.Result is not null)
            {
                _spifCount = spifsTask.Result.Count;
                _activeSpifCount = spifsTask.Result.Count(s => s.IsActive);
            }

            if (policySetsTask.IsCompletedSuccessfully && policySetsTask.Result is not null)
                _policySetCount = policySetsTask.Result.Count;

            if (pipSourcesTask.IsCompletedSuccessfully && pipSourcesTask.Result is not null)
                _pipSourceCount = pipSourcesTask.Result.Count;

            if (pepTask.IsCompletedSuccessfully && pepTask.Result is not null)
                _pepCount = pepTask.Result.Count;

            if (statusTask.IsCompletedSuccessfully && statusTask.Result is not null)
            {
                var status = statusTask.Result;
                _statusReady = status.Ready;
                _runtime = status.Runtime;
                _registeredCodecs = status.RegisteredLabelCodecs;
                _registeredOids = status.RegisteredPolicyOids;
            }
        }
        catch
        {
            // Dashboard loads gracefully even if some endpoints are unavailable
        }

        await LoadMetricsAsync();
        await LoadPipHealthAsync();
    }

    private async Task LoadMetricsAsync()
    {
        try
        {
            var metricsText = await Http.GetStringAsync("metrics");
            ParsePrometheusMetrics(metricsText);
            _metricsLoaded = true;
            _metricsUpdatedAt = DateTime.Now;
        }
        catch
        {
            // Metrics endpoint may not be available
        }
    }

    private void ParsePrometheusMetrics(string text)
    {
        foreach (var line in text.Split('\n'))
        {
            if (line.StartsWith('#') || string.IsNullOrWhiteSpace(line))
                continue;

            var parts = line.Split(' ', 2);
            if (parts.Length != 2 || !double.TryParse(parts[1], System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var value))
                continue;

            switch (parts[0])
            {
                case "abac_evaluations_total":
                    _totalEvaluations = (long)value;
                    break;
                case "abac_evaluations_by_decision_total{decision=\"permit\"}":
                    _permitCount = (long)value;
                    break;
                case "abac_evaluations_by_decision_total{decision=\"deny\"}":
                    _denyCount = (long)value;
                    break;
                case "abac_evaluations_by_decision_total{decision=\"not_applicable\"}":
                    _notApplicableCount = (long)value;
                    break;
                case "abac_evaluations_by_decision_total{decision=\"indeterminate\"}":
                    _indeterminateCount = (long)value;
                    break;
                case "abac_batch_evaluations_total":
                    _batchCount = (long)value;
                    break;
                case "abac_cache_hits_total":
                    _cacheHits = (long)value;
                    break;
                case "abac_cache_misses_total":
                    _cacheMisses = (long)value;
                    break;
                case "abac_pip_resolutions_total":
                    _pipResolutions = (long)value;
                    break;
                case "abac_pip_failures_total":
                    _pipFailures = (long)value;
                    break;
                case "abac_evaluation_duration_ms_sum":
                    var count = _totalEvaluations > 0 ? _totalEvaluations : 1;
                    _avgEvalMs = (value / count).ToString("F1");
                    break;
            }
        }

        var totalCacheOps = _cacheHits + _cacheMisses;
        _cacheHitRate = totalCacheOps > 0
            ? $"{(double)_cacheHits / totalCacheOps * 100:F1}%"
            : "—";
    }

    private async Task LoadPipHealthAsync()
    {
        try
        {
            var health = await Http.GetFromJsonAsync<PipHealthResult>("pip/api/health/cached");
            if (health is not null)
            {
                _pipAllHealthy = health.AllHealthy;
                _pipHealthSources = health.Sources;
                _pipHealthLoaded = true;
            }
        }
        catch
        {
            // PIP health may not be available
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private sealed record SpifRow(Guid Id, string PolicyOid, string Name, bool IsActive);
    private sealed record StatusRow(bool Ready, string Runtime, List<string>? RegisteredLabelCodecs, List<string>? RegisteredPolicyOids);
    private sealed record PipHealthResult(bool AllHealthy, int SourceCount, List<PipHealthRow> Sources);
    private sealed record PipHealthRow(string SourceId, bool Healthy, DateTimeOffset? LastChecked, string? Message);
}
